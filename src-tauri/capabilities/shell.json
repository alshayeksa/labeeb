{
  "identifier": "shell",
  "description": "Only trusted local shell gets narrow app commands. Remote pages have no capability.",
  "webviews": [
    "main"
  ],
  "local": true,
  "permissions": [
    "allow-app-snapshot",
    "allow-vault-unlock",
    "allow-vault-status",
    "allow-vault-list",
    "allow-vault-add",
    "allow-vault-reveal",
    "allow-vault-delete",
    "allow-password-offer-dismiss",
    "allow-password-offer-save",
    "allow-password-fill-choices",
    "allow-password-fill",
    "allow-tab-find",
    "allow-download-retry",
    "allow-download-reveal",
    "allow-download-dismiss",
    "allow-downloads-clear",
    "allow-download-open",
    "allow-download-delete",
    "allow-media-delete",
    "allow-viora-open",
    "allow-viora-choose",
    "allow-site-data-clear",
    "allow-video-start",
    "allow-video-direct",
    "allow-media-list",
    "allow-media-thumbnail",
    "allow-media-open",
    "allow-video-cancel",
    "allow-video-choose-folder",
    "allow-diagnostics-snapshot",
    "allow-tab-create",
    "allow-tab-select",
    "allow-tab-close",
    "allow-tab-navigate",
    "allow-tab-action",
    "allow-tab-zoom",
    "allow-tab-reopen",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-browser-bounds",
    "allow-bookmark-add",
    "allow-bookmark-remove",
    "allow-bookmark-unstar",
    "allow-history-clear",
    "allow-download-cancel",
    "allow-settings-update",
    "allow-window-fullscreen-toggle",
    "allow-window-drag",
    "allow-window-close",
    "allow-favicon",
    "allow-tab-move",
    "allow-ai-key-save",
    "allow-ai-key-delete",
    "allow-ai-ask",
    "allow-page-context",
    "allow-reader-export",
    "allow-ai-cancel"
  ]
}

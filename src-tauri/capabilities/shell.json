{
  "identifier": "shell",
  "description": "Only trusted local shell gets narrow app commands. Remote pages have no capability.",
  "webviews": [
    "main"
  ],
  "local": true,
  "permissions": [
    "allow-app-snapshot",
    "allow-tab-find",
    "allow-download-retry",
    "allow-video-start",
    "allow-video-direct",
    "allow-media-list",
    "allow-media-thumbnail",
    "allow-media-open",
    "allow-video-cancel",
    "allow-video-choose-folder",
    "allow-diagnostics-snapshot",
    "allow-tab-create",
    "allow-tab-select",
    "allow-tab-close",
    "allow-tab-navigate",
    "allow-tab-action",
    "allow-tab-zoom",
    "allow-tab-reopen",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-browser-bounds",
    "allow-bookmark-add",
    "allow-bookmark-remove",
    "allow-history-clear",
    "allow-download-cancel",
    "allow-approval-resolve",
    "allow-settings-update",
    "allow-ai-key-save",
    "allow-ai-key-delete",
    "allow-ai-ask",
    "allow-automation-start",
    "allow-automation-stop",
    "allow-automation-navigate",
    "allow-automation-input"
  ]
}

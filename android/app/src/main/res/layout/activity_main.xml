<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <FrameLayout
            android:id="@+id/webContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ScrollView
                android:id="@+id/home"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/canvas"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/logo" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/app_name"
                            android:textColor="@color/text"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/langBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_btn_outline"
                            android:clickable="true"
                            android:contentDescription="@string/lang_switch_desc"
                            android:focusable="true"
                            android:gravity="center"
                            android:minWidth="48dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/lang_switch"
                            android:textColor="@color/muted"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:lineSpacingMultiplier="1.15"
                        android:text="@string/home_title"
                        android:textAlignment="viewStart"
                        android:textColor="@color/text"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingMultiplier="1.35"
                        android:text="@string/home_sub"
                        android:textAlignment="viewStart"
                        android:textColor="@color/muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/appsLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="@string/your_apps"
                        android:textAlignment="viewStart"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />

                    <GridLayout
                        android:id="@+id/appsGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:columnCount="4" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/your_sites"
                        android:textAlignment="viewStart"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />

                    <GridLayout
                        android:id="@+id/sitesGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:columnCount="4" />

                    <LinearLayout
                        android:id="@+id/continueCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_box"
                            android:importantForAccessibility="no"
                            android:scaleType="center"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/accent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/continue_where"
                                android:textAlignment="viewStart"
                                android:textColor="@color/muted"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/continueTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAlignment="viewStart"
                                android:textColor="@color/text"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ListView
                android:id="@+id/suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@color/panel"
                android:divider="@null"
                android:visibility="gone" />
        </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressBackgroundTint="@color/surface"
            android:progressTint="@color/accent"
            android:visibility="invisible" />

        <View
            android:id="@+id/barLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/hairline" />

        <TextView
            android:id="@+id/miniBar"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/show_bar"
            android:focusable="true"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/muted"
            android:textDirection="ltr"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/fillBar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:drawablePadding="8dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:singleLine="true"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/findBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/findInput"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill"
                android:hint="@string/find_in_page"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/findCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/findPrev"
                style="@style/IconBtn"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:contentDescription="@string/previous"
                android:src="@drawable/ic_up" />

            <ImageButton
                android:id="@+id/findNext"
                style="@style/IconBtn"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:contentDescription="@string/next"
                android:src="@drawable/ic_down" />

            <ImageButton
                android:id="@+id/findClose"
                style="@style/IconBtn"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/menuBtn"
                style="@style/IconBtn"
                android:layout_width="52dp"
                android:layout_height="56dp"
                android:contentDescription="@string/menu"
                android:src="@drawable/ic_menu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageButton
                    android:id="@+id/startBtn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:contentDescription="@string/address_hint"
                    android:scaleType="center"
                    android:src="@drawable/ic_search"
                    app:tint="@color/muted" />

                <EditText
                    android:id="@+id/address"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:drawablePadding="6dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:hint="@string/address_hint"
                    android:imeOptions="actionGo|flagNoExtractUi"
                    android:inputType="text|textNoSuggestions"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/endBtn"
                    style="@style/IconBtn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/voice_search"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/muted" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/tabsBtn"
                android:layout_width="52dp"
                android:layout_height="56dp"
                android:background="?selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tabsCount"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_count"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/canvas"
        android:clickable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tabs"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabsSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="viewStart"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabsSeg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/segNormal"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/segPrivate"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/tabs_private"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/privateHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/private_hint"
            android:textAlignment="viewStart"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tabsList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="13dp"
            android:paddingTop="6dp"
            android:paddingEnd="13dp"
            android:paddingBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/hairline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/closeAllBtn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/close_all"
                android:textAlignment="viewStart"
                android:textColor="@color/danger"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/newTabBtn"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_accent_circle"
                android:contentDescription="@string/new_tab"
                android:elevation="3dp"
                android:scaleType="center"
                android:src="@drawable/ic_plus"
                app:tint="@color/on_accent" />

            <TextView
                android:id="@+id/doneBtn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/done"
                android:textAlignment="viewEnd"
                android:textColor="@color/accent"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />
</FrameLayout>
